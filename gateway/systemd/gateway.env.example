# Copy to ~/.config/breathsense/gateway.env and edit for the deployment.
# If omitted, the database defaults to the repository's cough_monitor.db.
# GATEWAY_DB_PATH=/home/your-user/pybgapi-examples/cough_monitor.db
GATEWAY_SOCKET_PATH=/tmp/cough_gw.sock
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8050
GATEWAY_LOG_LEVEL=INFO

# Leave empty to retain telemetry locally without attempting remote upload.
# A remote BreathSense server accepts POST /api/telemetry and ACKs event_id.
GATEWAY_UPLOAD_URL=
GATEWAY_UPLOAD_BATCH_SIZE=100
GATEWAY_UPLOAD_TIMEOUT_SECONDS=10
GATEWAY_UPLOAD_BACKOFF_INITIAL_SECONDS=5
GATEWAY_UPLOAD_BACKOFF_MAX_SECONDS=300
GATEWAY_DISK_CHECK_SECONDS=60
GATEWAY_DISK_WARN_PERCENT=80
GATEWAY_DISK_CRITICAL_PERCENT=90
